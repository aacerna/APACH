{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "node"],
    "baseUrl": ".",
    "paths": { "@shared/*": ["../../packages/shared/src/*"], "@content/*": ["../../packages/shared/content/*"], "vitest": ["./node_modules/vitest"] }
  },
  "include": ["src", "../../packages/shared/src", "vite.config.ts", "e2e", "playwright.config.ts"]
}
