# Copia este archivo como .env y cambia los valores. Nunca subas .env al repositorio.
POSTGRES_USER=apach
POSTGRES_PASSWORD=cambia-esta-clave-local
POSTGRES_DB=apach

# development | demo | production  (seed_demo se niega en production)
APACH_ENV=demo
# Solo development/demo: el ADMIN ve enlaces de activación/restablecimiento (APACH no envía correos).
APACH_EXPOSE_DEV_LINKS=true
# URL con la que se abre la app (para construir enlaces de activación).
APACH_PUBLIC_BASE_URL=http://localhost:8080
# true si se sirve con HTTPS real.
APACH_COOKIE_SECURE=false
APACH_MAX_UPLOAD_MB=10
APACH_INSTITUTIONAL_CONTACT=Coordinación académica de la Escuela de Ciencias de la Comunicación

# Puerto local de la aplicación web
WEB_PORT=8080

# Opcional: certificado CA adicional para construir imágenes detrás de un proxy con inspección TLS.
# EXTRA_CA_FILE=/ruta/a/ca-corporativa.pem
